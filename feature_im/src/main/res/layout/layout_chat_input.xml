<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical">

    <include layout="@layout/layout_line" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivAudioIcon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_margin="10px"
            android:src="@mipmap/ic_audio" />

        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingLeft="8dp"
            android:paddingTop="8dp"
            android:paddingRight="8dp"
            android:paddingBottom="8dp">

            <EditText
                android:id="@+id/etContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/shape_message_chat_bg"
                android:maxLines="3"
                android:minHeight="34dp"
                android:paddingHorizontal="12dp"
                android:textColor="#03081A"
                android:textCursorDrawable="@drawable/shape_cursor"
                android:textSize="14sp" />

            <com.scheartmed.lib_im.widget.RecordButton
                android:id="@+id/btnAudio"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/shape_session_btn_voice"
                android:stateListAnimator="@null"
                android:text="按住 说话"
                android:textSize="13dp"
                android:textStyle="bold"
                android:visibility="gone" />
        </RelativeLayout>

        <ImageView
            android:id="@+id/ivEmo"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_margin="10px"
            android:background="@mipmap/ic_chang" />

        <ImageView
            android:id="@+id/ivAdd"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginLeft="10px"
            android:layout_marginRight="14px"
            android:background="@mipmap/ic_add" />

        <com.scheartmed.lib_im.widget.StateButton
            android:id="@+id/btnSend"
            android:layout_width="50dp"
            android:layout_height="30dp"
            android:layout_marginRight="10dp"
            android:gravity="center"
            android:padding="1dp"
            android:text="发送"
            android:textColor="@color/white"
            android:textSize="13dp"
            android:visibility="gone"
            app:normalBackgroundColor="#0077FF"
            app:pressedBackgroundColor="#0f519b"
            app:radius="15dp" />

    </LinearLayout>
</LinearLayout>