<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/rc_audio_state"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_gravity="center"
        android:background="@drawable/shape_recording"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rc_audio_state_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:text="0:00"
            android:textColor="@color/c_white"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/rc_audio_state_image_gif"
            android:layout_width="75dp"
            android:layout_height="75dp"
            android:layout_marginTop="10dp" />

        <ImageView
            android:id="@+id/rc_audio_state_image_tanhan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="@mipmap/ic_tanhao"
            android:visibility="gone" />

        <TextView
            android:id="@+id/rc_audio_state_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:text="松开发送 上滑取消"
            android:textColor="@android:color/white"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>